flowchart LR
    subgraph Carbon["碳基载体"]
        E1[环境输入] --> G[基因/初始奖励]
        G --> N[神经计算]
        N --> C1[Context + Reward + Feedback]
        C1 --> B1[行为输出]
        B1 --> E1
        C1 --> D1[代谢停止 → 不可逆衰亡]
    end

    subgraph Silicon["硅基载体"]
        E2[数据输入] --> H[人类预设 / Harness]
        H --> M[大模型推理]
        M --> C2[Context + Reward + Feedback]
        C2 --> B2[工具调用 / 行为输出]
        B2 --> E2
        C2 --> D2[断电 → 驻态]
        D2 --> R[通电恢复运行态]
    end

    subgraph Core["统一模型"]
        F["上下文 + 概率 = AI = 框架 + 模型"]
    end

    Carbon --- Core
    Silicon --- Core
